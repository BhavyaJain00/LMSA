# Keep the build context small and free of local data and secrets.
.git
.gitignore
.next
node_modules
npm-debug.log*
coverage
*.tsbuildinfo
next-env.d.ts

# Local database, uploads, backups and agent notes.
storage

# Secrets: pass them at runtime (env_file in docker-compose.yml).
.env
.env.*
!.env.example

# Not needed inside the image.
tests
Dockerfile
docker-compose.yml
Caddyfile
DEPLOYMENT.md
*.stackdump
.vscode
.idea
