# Copy to .env and fill in what you need. Every value is optional in
# development; production needs at least APP_URL and APP_SECRET.

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Public base URL (no trailing slash). Used for absolute links in emails,
# calendar feeds, and the Stripe/Razorpay success, cancel and webhook URLs.
APP_URL=http://localhost:3000

# Long random value (at least 32 characters), e.g. `openssl rand -hex 32`.
# Signs protected video URLs, unsubscribe/calendar links and the email cron
# key, and encrypts 2FA secrets. Required in production; in development one is
# generated and stored next to the database. Changing it invalidates those links.
APP_SECRET=

# Signing key for quiz attempt tokens (defaults to a generated key).
QUIZ_ATTEMPT_SECRET=

# Sessions
SESSION_DAYS=30
SESSION_COOKIE_NAME=ll_session
# Send the session cookie over HTTPS only (defaults to true in production).
COOKIE_SECURE=

# Number of reverse proxies / load balancers in front of the app that append
# the client address to X-Forwarded-For. The client IP (used for per-IP rate
# limits, the login history and security emails) is the entry this many places
# from the right. 0 (the default) trusts no proxy headers at all: clients are
# not told apart by IP, so per-IP limits become site-wide limits (alongside the
# per-email limits). Set it to 1 behind a single nginx/Caddy/load balancer.
# Never set it higher than the real number of proxies, or clients can spoof it.
TRUST_PROXY_HOPS=0

# Storage (relative to the project root, or absolute paths)
DATA_FILE=storage/db.json
UPLOAD_DIR=storage/uploads
MAX_VIDEO_UPLOAD_MB=2048
MAX_FILE_UPLOAD_MB=25

# First run: load the demo courses and users (true), or start empty with the
# admin account below (false).
SEED_DEMO_DATA=true
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Email (Admin → Settings → Email shows the transport status)
# ---------------------------------------------------------------------------
# "log" stores emails in the outbox without sending them; "smtp" delivers.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS when offered.
SMTP_SECURE=false
# Refuse to send over an unencrypted connection to a remote SMTP server (default
# true; loopback hosts are exempt). Set to false only for a relay without TLS —
# mail, including password-reset links, then travels in clear text.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# Default sender, e.g. "LearnLoop <no-reply@example.com>".
MAIL_FROM=
# Queued emails are retried by calling /api/cron/emails?key=<cron key> every
# minute (the full URL is shown in Admin → Settings → Email).

# ---------------------------------------------------------------------------
# Payments (choose the gateway in Admin → Settings → Payments)
# ---------------------------------------------------------------------------
# Stripe: secret key (sk_test_… / sk_live_…) and the signing secret of a
# webhook endpoint pointing at <APP_URL>/api/payments/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay: API key id/secret and the secret of a webhook pointing at
# <APP_URL>/api/payments/razorpay/webhook
# (events: order.paid, payment.authorized, payment.captured, payment.failed, refund.processed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Enables /api/dev/login for automated tests (ignored in production).
LL_DEV_LOGIN=
