# LearnLoop environment template. Copy to .env and fill in what you need.
# DATABASE_URL (PostgreSQL, e.g. Supabase) is required everywhere, also in
# development; production also needs APP_URL (https://) and APP_SECRET. The
# rest is optional. Never commit .env. Step by step: ENV-SETUP.md; full
# reference: DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL without a trailing slash. Used for links in emails, calendar
# feeds, payment callbacks, canonical URLs, the sitemap and cron URLs.
APP_URL=http://localhost:3000

# At least 32 random characters, e.g. `openssl rand -hex 32`. Signs protected
# video URLs, unsubscribe/calendar links and the cron key, and encrypts 2FA
# secrets. Required in production; in development one is generated and kept
# in STORAGE_DIR. Changing it invalidates those links and 2FA enrolments.
APP_SECRET=

# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (client IP = that many entries from the right). 0 trusts no proxy headers,
# so per-IP rate limits become site-wide. 1 behind Caddy/nginx (docker-compose
# sets it); 2 with a CDN in front of Caddy. Never higher than the real count.
TRUST_PROXY_HOPS=0

# Server time zone, used for dates printed on certificates (e.g. Asia/Kolkata).
TZ=
# Version string reported by /api/health (the Docker build sets it).
APP_VERSION=
# NODE_ENV, PORT and HOSTNAME are read by Next.js itself: `npm run dev` and
# `npm start` set NODE_ENV; the Docker image and systemd unit set all three.

# ---------------------------------------------------------------------------
# First start
# ---------------------------------------------------------------------------
# true loads demo courses and the demo accounts (public password
# "password123") into a NEW database. Always false in production.
SEED_DEMO_DATA=true
# Administrator created in a new, empty database when SEED_DEMO_DATA=false.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions and signing
# ---------------------------------------------------------------------------
# Sign-in session length in days.
SESSION_DAYS=30
# Name of the session cookie.
SESSION_COOKIE_NAME=ll_session
# Send the session cookie over HTTPS only (empty = true in production).
COOKIE_SECURE=
# Separate signing key for quiz attempt tokens (empty = generated).
QUIZ_ATTEMPT_SECRET=

# ---------------------------------------------------------------------------
# Database, backups and uploads (paths relative to the project root, or
# absolute; without Docker use absolute paths outside the project, see DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# PostgreSQL is the only database (Supabase or any PostgreSQL 13+); the app
# does not start without DATABASE_URL. Step by step: ENV-SETUP.md, section 3.
# Supabase: Connect -> ORMs -> Prisma. The app uses the transaction pooler
# (port 6543) with pgbouncer=true and a small connection_limit:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
DATABASE_URL=
# Used by `npm run db:setup` (prisma migrate deploy; the Docker image runs it
# on every start). Schema changes cannot go through the transaction pooler:
# Supabase's session pooler (port 5432) or the direct connection. Without a
# pooler, the same value as DATABASE_URL:
#   DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=
# Docker only: password of the optional local `postgres` service
# (`docker compose --profile postgres up -d`, see docker-compose.yml).
POSTGRES_PASSWORD=
# Throwaway PostgreSQL for `npm run test:pg` only (never a real site's database):
#   TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/postgres
TEST_DATABASE_URL=
# Folder for the app's own files: backups (JSON exports, in backups/), SEO
# files (seo/) and, in development, generated secrets.
STORAGE_DIR=storage
# Automatic daily backup on the first request of each day (false turns it off).
DB_AUTO_BACKUP=true
# Number of daily backups kept (1-3650).
DB_BACKUP_KEEP=14
# Folder for uploaded files when STORAGE_DRIVER=local.
UPLOAD_DIR=storage/uploads
# Upload limits in MB. Video uploads are chunked and resumable (default 10 GB).
MAX_VIDEO_UPLOAD_MB=10240
MAX_FILE_UPLOAD_MB=25
# New uploads are refused while the upload disk has less than this free (MB).
UPLOAD_MIN_FREE_MB=1024
# What one learner (non-staff account) may upload per rolling 24 hours (MB).
UPLOAD_LEARNER_DAILY_MB=500

# ---------------------------------------------------------------------------
# Object storage (Admin -> Settings -> Storage & video shows the status and
# has "Test connection")
# ---------------------------------------------------------------------------
# "local" keeps uploads in UPLOAD_DIR (development default); "s3" uses a bucket.
# Live sites: AWS S3 (step by step, with the IAM policy and free-tier notes:
# ENV-SETUP.md section 4). Cloudflare R2, Backblaze B2 and MinIO work too.
STORAGE_DRIVER=local
# Empty for AWS S3. R2: https://<account id>.r2.cloudflarestorage.com
# B2: https://s3.<region>.backblazeb2.com   MinIO: http://localhost:9000
S3_ENDPOINT=
# The bucket's region, e.g. ap-south-1 (Mumbai) for AWS. Always set it for AWS:
# empty (= "auto") signs for us-east-1. R2: auto.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional https:// CDN origin (e.g. CloudFront) for unprotected files; leave
# empty with a private bucket (every file is then served through the app and the
# bucket needs no CORS rules). With a CDN, its CORS rules must allow GET/HEAD
# from APP_URL. Protected videos always use signed URLs.
S3_PUBLIC_BASE_URL=
# true forces path-style bucket URLs (MinIO usually needs it).
S3_FORCE_PATH_STYLE=

# Extra HTTPS hosts the image optimizer may fetch from, comma-separated
# (cdn.example.com,*.example.org). APP_URL and the bucket are always allowed.
# Read at build time.
IMAGE_HOSTS=

# ---------------------------------------------------------------------------
# Video processing, captions and AI (all optional)
# ---------------------------------------------------------------------------
# ffmpeg converts uploaded videos to adaptive HLS. Set these only when ffmpeg
# and ffprobe are not on the PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Automatic captions through a Whisper-compatible speech-to-text API.
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
# AI tutor (can also be set in Admin -> Settings -> AI tutor).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Email (Admin -> Settings -> Email shows the status and sends a test)
# ---------------------------------------------------------------------------
# "log" keeps emails in the outbox without sending them; "smtp" delivers.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS when offered.
SMTP_SECURE=false
# Refuse to send over an unencrypted connection to a remote server (default
# true; loopback hosts are exempt). false only for a trusted relay without TLS.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# Default sender, e.g. "LearnLoop <no-reply@example.com>".
MAIL_FROM=

# ---------------------------------------------------------------------------
# Payments (choose the gateway in Admin -> Settings -> Payments)
# ---------------------------------------------------------------------------
# Stripe secret key (sk_test_... / sk_live_...) and webhook signing secret
# (whsec_...) for <APP_URL>/api/payments/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay API keys, and the secret you chose for
# <APP_URL>/api/payments/razorpay/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Search engines
# ---------------------------------------------------------------------------
# Host redirects: empty = redirect only the www twin of the APP_URL host;
# "all" = redirect every other host name (only when the proxy forwards the
# visitor's Host header); "off" = no host redirects.
SEO_CANONICAL_HOST=

# ---------------------------------------------------------------------------
# Docker Compose only (read by docker-compose.yml and the Caddyfile, not the app)
# ---------------------------------------------------------------------------
# Domain Caddy serves and gets a certificate for, e.g. learn.example.com.
DOMAIN=
# Email for certificate expiry notices.
ACME_EMAIL=
# Cron key from Admin -> Settings -> Email, for `docker compose --profile cron`.
CRON_KEY=

# ---------------------------------------------------------------------------
# Development only (ignored in production)
# ---------------------------------------------------------------------------
# Enables /api/dev/login for automated tests.
LL_DEV_LOGIN=
# Lets outgoing webhooks reach localhost and private network addresses.
WEBHOOKS_ALLOW_PRIVATE_NETWORK=
# Print stack traces from the npm run db:* scripts.
DEBUG=
