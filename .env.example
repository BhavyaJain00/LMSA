# Copy to .env and fill in what you need. Every value is optional in
# development; production needs at least APP_URL and APP_SECRET.

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Public base URL (no trailing slash). Used for absolute links in emails,
# calendar feeds, and the Stripe/Razorpay success, cancel and webhook URLs.
APP_URL=http://localhost:3000

# Long random value (at least 32 characters), e.g. `openssl rand -hex 32`.
# Signs protected video URLs, unsubscribe/calendar links and the email cron
# key, and encrypts 2FA secrets. Required in production; in development one is
# generated and stored next to the database. Changing it invalidates those links.
APP_SECRET=

# Signing key for quiz attempt tokens (defaults to a generated key).
QUIZ_ATTEMPT_SECRET=

# Sessions
SESSION_DAYS=30
SESSION_COOKIE_NAME=ll_session
# Send the session cookie over HTTPS only (defaults to true in production).
COOKIE_SECURE=

# Number of reverse proxies / load balancers in front of the app that append
# the client address to X-Forwarded-For. The client IP (used for per-IP rate
# limits, the login history and security emails) is the entry this many places
# from the right. 0 (the default) trusts no proxy headers at all: clients are
# not told apart by IP, so per-IP limits become site-wide limits (alongside the
# per-email limits). Set it to 1 behind a single nginx/Caddy/load balancer.
# Never set it higher than the real number of proxies, or clients can spoof it.
TRUST_PROXY_HOPS=0

# Storage (relative to the project root, or absolute paths)
# Database engine: "sqlite" (default, needs Node.js 22.13 or newer for the
# built-in node:sqlite module) or "json" (a single JSON file; development only).
DB_DRIVER=sqlite
# The SQLite database file. On the first start an existing DATA_FILE is
# imported into it once and then renamed to db.json.migrated-<timestamp>.
SQLITE_PATH=storage/lms.sqlite
# The JSON database (DB_DRIVER=json), and the one-time import source for SQLite.
DATA_FILE=storage/db.json
# Automatic daily database backup into storage/backups/ (false turns it off).
DB_AUTO_BACKUP=true
# Number of daily backups kept (1-3650).
DB_BACKUP_KEEP=14
UPLOAD_DIR=storage/uploads
# Upload limits in MB. Video uploads are chunked and resumable, so files over
# 5 GB work (default 10240 = 10 GB).
MAX_VIDEO_UPLOAD_MB=10240
MAX_FILE_UPLOAD_MB=25
# New uploads are refused while the upload disk has less than this free (MB).
UPLOAD_MIN_FREE_MB=1024
# What one learner (non-staff account) may upload per rolling 24 hours, in MB.
UPLOAD_LEARNER_DAILY_MB=500

# ---------------------------------------------------------------------------
# Object storage (optional; Admin → Settings → Storage & video shows the status)
# ---------------------------------------------------------------------------
# "local" (default) keeps uploads in UPLOAD_DIR; "s3" uses any S3-compatible
# bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER=local
# Empty for AWS S3. Cloudflare R2: https://<account id>.r2.cloudflarestorage.com
# Backblaze B2: https://s3.<region>.backblazeb2.com   MinIO: http://localhost:9000
S3_ENDPOINT=
# Optional; inferred from the endpoint when empty (e.g. eu-central-1 for AWS).
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional https:// CDN or public-bucket origin for files that are not
# protected (thumbnails, unprotected videos). Its CORS rules must allow GET
# from APP_URL. Protected videos are always served through signed URLs.
S3_PUBLIC_BASE_URL=
# Optional: true forces path-style bucket URLs (MinIO usually needs it).
S3_FORCE_PATH_STYLE=

# ---------------------------------------------------------------------------
# Video processing, captions and AI (all optional)
# ---------------------------------------------------------------------------
# ffmpeg converts uploaded videos to adaptive HLS. Set these when ffmpeg and
# ffprobe are not on the PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Automatic captions through a Whisper-compatible speech-to-text API.
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
# AI tutor (can also be set in Admin → Settings → AI tutor).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Search engines and server
# ---------------------------------------------------------------------------
# Host redirects: unset = redirect only the www twin of the APP_URL host;
# "all" = redirect every other host name (only when the reverse proxy forwards
# the visitor's Host header); "off" = no host redirects. The storage/ folder
# (including storage/seo/) must be writable and persisted with the database.
SEO_CANONICAL_HOST=
# Server time zone, used for dates printed on certificates (e.g. Asia/Kolkata).
TZ=
# Version string reported by /api/health (the Docker build sets it).
APP_VERSION=
SEED_DEMO_DATA=true
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Email (Admin → Settings → Email shows the transport status)
# ---------------------------------------------------------------------------
# "log" stores emails in the outbox without sending them; "smtp" delivers.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS when offered.
SMTP_SECURE=false
# Refuse to send over an unencrypted connection to a remote SMTP server (default
# true; loopback hosts are exempt). Set to false only for a relay without TLS —
# mail, including password-reset links, then travels in clear text.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# Default sender, e.g. "LearnLoop <no-reply@example.com>".
MAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Enables /api/dev/login for automated tests (ignored in production).
LL_DEV_LOGIN=
# Lets outgoing webhooks reach localhost and private network addresses, for
# testing a receiver on your own machine (ignored in production).
WEBHOOKS_ALLOW_PRIVATE_NETWORK=
